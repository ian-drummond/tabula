# Copy to .env.local for local development; set the same two in Vercel → Project → Settings → Environment Variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Set to true only when Supabase allows new users; shows "Create an account" on the sign-in page.
VITE_SIGNUPS_OPEN=false
